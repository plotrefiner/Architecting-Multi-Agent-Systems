{
  "pii_policy": {
    "classifications": [
      "public",
      "internal",
      "confidential",
      "restricted_pii",
      "secret"
    ],
    "redact_before_model_context": [
      "credit_card_number",
      "access_token",
      "api_key",
      "internal_risk_score"
    ],
    "allow_task_scoped_access": {
      "customer_context_agent": [
        "order_id",
        "delivery_date",
        "shipping_region"
      ],
      "response_writer_agent": [
        "first_name_if_required",
        "order_summary"
      ],
      "policy_agent": []
    },
    "never_log_raw": [
      "credit_card_number",
      "api_key",
      "access_token"
    ]
  }
}
